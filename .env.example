###############################################################################
# Singla & Singla Law Firm — environment reference
#
# This file is documentation only. Copy the relevant blocks into TWO real files:
#
#   client/.env.local   <- the NEXT_PUBLIC_* block
#   server/.env         <- everything else
#
# Both are gitignored. Never commit real credentials.
###############################################################################


# =============================================================================
# CLIENT  ->  client/.env.local
# =============================================================================
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle at build
# time. Only put values here that are safe to make public.

# Canonical site origin. Drives canonical URLs, sitemap.xml, robots.txt and
# Open Graph tags. Must be the real production domain or SEO output is wrong.
NEXT_PUBLIC_SITE_URL=https://www.singlalawfirm.com

# Base URL of the Express API, including the /api suffix.
# Local:      http://localhost:5000/api
# Production: https://your-service.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# WhatsApp number in international format, digits only — no +, spaces or dashes.
# 91 = India. Used to build the wa.me deep link.
NEXT_PUBLIC_WHATSAPP_NUMBER=919811135465

# --- Optional -----------------------------------------------------------------

# reCAPTCHA v3 SITE key (the public half). Leave blank to fall back to the
# honeypot + timing + rate-limit checks, which work with no setup.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Google Search Console HTML-tag verification token (just the token).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Maps Embed API URL if you want a keyed embed. Leave blank to use the keyless
# embed built from the address in client/content/site.ts.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Set to false on staging/preview deploys so robots.txt blocks all crawlers and
# duplicate copies of the site never compete with production in search.
NEXT_PUBLIC_ALLOW_INDEXING=true


# =============================================================================
# SERVER  ->  server/.env
# =============================================================================

NODE_ENV=development
PORT=5000

# Public site URL, used in email templates for links and the footer.
SITE_URL=https://www.singlalawfirm.com

# --- Database -----------------------------------------------------------------
# The name after the final slash IS the database — enquiries land there, so if
# the admin UI looks empty, check you are inspecting that exact name and host.
# Percent-encode any special characters in the password. Leave blank to run
# without persistence (emails still send).
#
# Local mongod:  mongodb://localhost:27017/singla_law_firm
# Atlas:
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/singla_law_firm?retryWrites=true&w=majority

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowlist of frontend origins permitted to call the API.
# Include every deployed frontend URL. No trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000,https://www.singlalawfirm.com

# --- SMTP (Nodemailer) --------------------------------------------------------
# Provider-agnostic. See README §"Email setup" for a per-provider table.
#
#   Gmail   smtp.gmail.com   465  secure=true  user=your address  pass=App Password
#   Resend  smtp.resend.com  465  secure=true  user=resend        pass=API key
#
# Gmail needs a 16-character App Password (the account password is rejected):
# enable 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords — note the ~500/day send cap.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourfirm@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx

# The VISIBLE SENDER. With Gmail this must be identical to SMTP_USER above, or
# an alias registered on that account under "Send mail as" — Gmail rewrites or
# rejects anything else, hence the matching default below.
#
# It is a separate setting because some relays issue a login that is not a
# mailbox; those need a sender verified with the provider instead. Switch this
# to a domain address (contact@singlalawfirm.com) only once you move to such a
# relay and have verified that domain.
MAIL_FROM_ADDRESS=yourfirm@gmail.com
MAIL_FROM_NAME=Singla & Singla Law Firm

# Mailbox that receives enquiry notifications.
ENQUIRY_RECIPIENT=naveensinglaadv1@gmail.com

# In development, fall back to an Ethereal test inbox when the transport above
# fails to verify (emails captured with a preview URL, never delivered).
# Always disabled when NODE_ENV=production. Set false to disable in dev too.
MAIL_DEV_FALLBACK=true

# Legacy aliases, still honoured if SMTP_USER/SMTP_PASS are unset:
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# --- Spam protection (optional) -----------------------------------------------
# reCAPTCHA v3 SECRET key (the private half). Must pair with the site key above.
RECAPTCHA_SECRET_KEY=
# Scores run 0.0 (bot) to 1.0 (human). 0.5 is Google's suggested threshold.
RECAPTCHA_MIN_SCORE=0.5

# --- Rate limiting ------------------------------------------------------------
# Max enquiry submissions per IP per window. 5 per 15 minutes is generous for a
# person and restrictive for a script.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5

# --- Logging ------------------------------------------------------------------
# error | warn | info | debug
LOG_LEVEL=debug
