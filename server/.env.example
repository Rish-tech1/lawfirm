# Copy to server/.env and fill in. See ../.env.example for full notes.

NODE_ENV=development
PORT=5000
SITE_URL=http://localhost:3000

MONGODB_URI=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP — see README §"Email setup" for per-provider host/port/secure values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Visible sender. NOT necessarily the same as SMTP_USER — most relays issue a
# login that is not a mailbox. Must be verified with your provider.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Singla & Singla Law Firm

# Where enquiries arrive.
ENQUIRY_RECIPIENT=

# Dev-only Ethereal fallback when the transport fails to verify.
MAIL_DEV_FALLBACK=true

# Optional
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5
LOG_LEVEL=debug
