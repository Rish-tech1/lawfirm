{
  "name": "singla-law-firm",
  "version": "1.0.0",
  "private": true,
  "description": "Premium website for Singla & Singla Law Firm — Next.js 15 frontend + Express/MongoDB backend",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "preview": "npm run build --workspace client && npm run start --workspace client",
    "start:client": "npm run start --workspace client",
    "start:server": "npm run start --workspace server",
    "lint": "npm run lint --workspace client",
    "typecheck": "npm run typecheck --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
